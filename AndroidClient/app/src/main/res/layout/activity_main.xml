<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Video Surface -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/streamStatusBarBinding"
        layout="@layout/view_stream_status_bar" />

    <!-- Settings Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settingsButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="24dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="@color/ss_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/settings_button_description"
            android:src="@drawable/ic_settings"
            app:tint="@color/ss_text_primary" />
    </androidx.cardview.widget.CardView>

    <!-- Modern Connection Panel -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:elevation="24dp"
        app:cardCornerRadius="32dp"
        app:cardBackgroundColor="@color/ss_scrim_strong"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="40dp">

            <!-- Icon -->
            <View
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/connection_icon_bg"
                android:layout_marginBottom="24dp" />

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ss_text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_turn_your_tablet_into_a_second_display"
                android:textColor="@color/ss_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Mode toggle: USB / Wireless -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/modeToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeUSB"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_usb"
                    android:textColor="@color/mode_toggle_text"
                    app:backgroundTint="@color/mode_toggle_bg"
                    app:strokeColor="@color/ss_outline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeWireless"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_wireless"
                    android:textColor="@color/mode_toggle_text"
                    app:backgroundTint="@color/mode_toggle_bg"
                    app:strokeColor="@color/ss_outline"
                    app:strokeWidth="1dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- ============= USB MODE CONTENT ============= -->
            <LinearLayout
                android:id="@+id/usbModeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Connection Checklist -->
            <LinearLayout
                android:id="@+id/checklistContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/instruction_bg"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_connection_checklist"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Developer Mode Check -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <View
                        android:id="@+id/checkDeveloperMode"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/status_indicator_red"
                        android:layout_marginEnd="10dp" />
                    <TextView
                        android:id="@+id/textDeveloperMode"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_developer_mode_enabled"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- USB Debugging Check -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <View
                        android:id="@+id/checkUsbDebugging"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/status_indicator_red"
                        android:layout_marginEnd="10dp" />
                    <TextView
                        android:id="@+id/textUsbDebugging"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_usb_debugging_enabled"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- USB Connected Check -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <View
                        android:id="@+id/checkUsbConnected"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/status_indicator_red"
                        android:layout_marginEnd="10dp" />
                    <TextView
                        android:id="@+id/textUsbConnected"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_usb_cable_connected"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Mac Server Check -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:id="@+id/checkMacServer"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/status_indicator_neutral"
                        android:layout_marginEnd="10dp" />
                    <TextView
                        android:id="@+id/textMacServer"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_mac_server_not_checked"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Connect Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/ui_connect"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/ss_accent"
                android:layout_marginBottom="20dp" />

            <!-- Status Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_indicator_neutral"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_ready_to_connect"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Advanced Settings (collapsed by default) -->
            <LinearLayout
                android:id="@+id/advancedSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/ss_outline_strong"
                    app:hintTextColor="@color/ss_text_secondary"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/hostInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ui_host"
                        android:text="@string/ui_127_0_0_1"
                        android:textColor="@color/ss_text_primary"
                        android:textColorHint="@color/ss_text_tertiary"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/ss_outline_strong"
                    app:hintTextColor="@color/ss_text_secondary">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/portInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ui_port"
                        android:text="@string/ui_54321"
                        android:textColor="@color/ss_text_primary"
                        android:textColorHint="@color/ss_text_tertiary"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Show Advanced link -->
            <TextView
                android:id="@+id/showAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_advanced_settings"
                android:textColor="@color/ss_accent"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="8dp" />

            </LinearLayout>
            <!-- ============= /USB MODE CONTENT ============= -->

            <!-- ============= WIRELESS MODE CONTENT ============= -->
            <LinearLayout
                android:id="@+id/wirelessModeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- State: Connecting (auto or after scan) -->
                <LinearLayout
                    android:id="@+id/wirelessConnecting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminateTint="@color/ss_accent"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/connectingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_connecting"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/connectingSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- State 1: First-time -->
                <LinearLayout
                    android:id="@+id/wirelessFirstTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_pair_with_your_mac"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_open_side_screen_on_your_mac_switch_to_the_wireless_tab_scan_the_qr_shown"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessScanButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/ui_scan_qr_code"
                        android:textSize="16sp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/ss_success"
                        android:textColor="@color/ss_on_accent" />
                </LinearLayout>

                <!-- State 3: Connected -->
                <LinearLayout
                    android:id="@+id/wirelessConnected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_connected"
                        android:textColor="@color/ss_success"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/connectedMacName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_mac"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/connectedMacIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_em_dash"
                        android:textColor="@color/ss_text_tertiary"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessDisconnectButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_disconnect"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessForgetButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_forget_this_mac"
                        android:textColor="@color/ss_error_soft"
                        app:strokeColor="@color/ss_error_container" />
                </LinearLayout>

                <!-- State: Paired idle (after explicit Disconnect) -->
                <LinearLayout
                    android:id="@+id/wirelessPairedIdle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_disconnected"
                        android:textColor="@color/ss_text_tertiary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/idleMacName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_mac"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/idleMacIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_em_dash"
                        android:textColor="@color/ss_text_tertiary"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessReconnectButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/ui_reconnect"
                        android:textSize="16sp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/ss_accent"
                        android:textColor="@color/ss_on_accent"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessIdleForgetButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_forget_this_mac"
                        android:textColor="@color/ss_error_soft"
                        app:strokeColor="@color/ss_error_container" />
                </LinearLayout>

                <!-- State 4: Token mismatch / re-pair -->
                <LinearLayout
                    android:id="@+id/wirelessTokenMismatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/repairTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_could_not_connect"
                        android:textColor="@color/ss_error_soft"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/repairMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_scan_a_fresh_qr_from_your_mac_to_re_pair"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessRepairReconnectButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/ui_reconnect"
                        android:textSize="16sp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/ss_accent"
                        android:textColor="@color/ss_on_accent"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessRescanButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_scan_qr_code"
                        android:textColor="@color/ss_text_secondary"
                        app:strokeColor="@color/ss_outline" />
                </LinearLayout>

                <!-- State 5: Permission denied permanently -->
                <LinearLayout
                    android:id="@+id/wirelessPermDenied"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/instruction_bg"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_camera_permission_required_to_scan_qr"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_you_blocked_the_permission_open_settings_apps_side_screen_permissions_to_allow"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wirelessOpenSettingsButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/ui_open_settings"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/ss_accent" />
                </LinearLayout>

            </LinearLayout>
            <!-- ============= /WIRELESS MODE CONTENT ============= -->

            <!-- Hidden disconnect button reference (needed by code) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.cardview.widget.CardView>

    <!-- Hidden log text (needed by code) -->
    <TextView
        android:id="@+id/logText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
