+package io.github.jqssun.airplay.service
+
+import android.util.Base64
+import java.io.File
+import java.security.MessageDigest
+
+// macOS remembers an AirPlay display's mode and arrangement per receiver identity (device id + public key).
+// Deriving both from the app-scoped ANDROID_ID keeps that identity across reinstalls and cleared data,
+// so the display comes back the way the user left it instead of as a new device.
+object ReceiverIdentity {
+
+    private const val MAC_LABEL = "sidetab-airplay-device-id:"
+    private const val KEY_LABEL = "sidetab-airplay-ed25519-seed:"
+
+    // PKCS#8 header for a raw 32-byte Ed25519 private key (RFC 8410)
+    private val ED25519_PKCS8_PREFIX = byteArrayOf(
+        0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20
+    )
+
+    fun mac(androidId: String): ByteArray {
+        val mac = _digest(MAC_LABEL, androidId).copyOf(6)
+        // locally administered unicast, AAI SLAP quadrant like the random fallback
+        mac[0] = ((mac[0].toInt() and 0xF0) or 0x0A).toByte()
+        return mac
+    }
+
+    fun privateKeyPem(androidId: String): String {
+        val der = ED25519_PKCS8_PREFIX + _digest(KEY_LABEL, androidId).copyOf(32)
+        val b64 = Base64.encodeToString(der, Base64.NO_WRAP)
+        return "-----BEGIN PRIVATE KEY-----\n$b64\n-----END PRIVATE KEY-----\n"
+    }
+
+    // rewrites the key only when it differs, so an existing derived key file is left untouched
+    fun writeKeyFile(file: File, androidId: String): Boolean = runCatching {
+        val pem = privateKeyPem(androidId)
+        if (file.exists() && file.readText() == pem) return@runCatching true
+        val tmp = File(file.parentFile, file.name + ".tmp")
+        tmp.writeText(pem)
+        tmp.renameTo(file)
+    }.getOrDefault(false)
+
+    private fun _digest(label: String, androidId: String): ByteArray =
+        MessageDigest.getInstance("SHA-256").digest((label + androidId).toByteArray(Charsets.UTF_8))
+}
